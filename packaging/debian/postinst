#!/bin/sh
set -e

# Source confmodule BEFORE any stdout (log/echo/printf). When dpkg runs this
# script through the debconf frontend — or when sourcing confmodule re-execs
# us under one — stdout is the protocol pipe. Text written there is parsed as
# a command; the frontend replies to it; the next db_get then reads that
# reply instead of the token. The stored debconf value is fine (debconf-show
# matches the token that works by hand); RET is not. That mangled argv is
# what the worker rejects as "invalid token".
if [ -f /usr/share/debconf/confmodule ]; then
  . /usr/share/debconf/confmodule
fi

# Binary and unit are already on disk (dpkg data tar):
#   /usr/bin/hookdeployed
#   /usr/lib/systemd/system/hookdeployed.service
# This script never downloads anything.

COMMON=/usr/share/hookdeployed/install-common.sh
# During local package tests the helper may still be next to this script.
if [ ! -f "${COMMON}" ] && [ -n "${HOOKDEPLOYED_INSTALL_COMMON:-}" ]; then
  COMMON="${HOOKDEPLOYED_INSTALL_COMMON}"
fi
# shellcheck source=../lib/install-common.sh
. "${COMMON}"

ensure_user
ensure_state_dirs

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
fi

TOKEN="${HOOKDEPLOYED_TOKEN:-}"
if [ -z "${TOKEN}" ] && type db_get >/dev/null 2>&1; then
  db_get hookdeployed/enroll_token || true
  TOKEN="${RET:-}"
fi

UNATTENDED_HINT="For unattended install, preseed hookdeployed/enroll_token or set HOOKDEPLOYED_TOKEN."

case "$1" in
  configure)
    if [ -n "${TOKEN}" ]; then
      # Enroll failure must not fail the package. Binary, unit, and user
      # are already on disk; a bad token or network error is not a dpkg error.
      if enroll_with_token /usr/bin/hookdeployed "${TOKEN}"; then
        if type db_set >/dev/null 2>&1; then
          db_set hookdeployed/enroll_token "" || true
          db_fset hookdeployed/enroll_token seen false || true
        fi
      else
        log "enrollment did not succeed — package is installed; enroll manually:"
        print_no_token_instructions /usr/bin/hookdeployed "${UNATTENDED_HINT}"
      fi
    elif already_enrolled && command -v systemctl >/dev/null 2>&1 \
      && systemctl is-enabled hookdeployed.service >/dev/null 2>&1; then
      # Upgrade of an already-enrolled, enabled install: pick up the new binary.
      systemctl restart hookdeployed.service || true
    else
      print_no_token_instructions /usr/bin/hookdeployed "${UNATTENDED_HINT}"
    fi
    ;;
esac

exit 0
