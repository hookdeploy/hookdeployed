#!/bin/sh
set -e
# Optional token prompt. Priority medium: default apt (priority high)
# does not ask; empty default → install only, enroll later.
# Skip db_input when a value is already preseeded so no frontend widget
# can rewrite or truncate it.
if [ -f /usr/share/debconf/confmodule ]; then
  . /usr/share/debconf/confmodule
  db_get hookdeployed/enroll_token || true
  if [ -z "${RET:-}" ]; then
    db_input medium hookdeployed/enroll_token || true
    db_go || true
  fi
fi
